AI_COLLAB_MODE=demo
AI_COLLAB_DB=var/app.sqlite3
# Required in production. Use a persistent deployment secret of at least 32 characters.
AI_COLLAB_PSEUDONYM_KEY=
# Optional and server-only. External evaluation also requires administrator and data-source opt-in.
AI_COLLAB_LLM_KEY=
DEEPSEEK_API_KEY=
AI_COLLAB_PROVIDER_HOSTS=api.openai.com
# Optional. Default is data/StudyChat alongside the implementation folder.
AI_COLLAB_STUDYCHAT_ROOT=
